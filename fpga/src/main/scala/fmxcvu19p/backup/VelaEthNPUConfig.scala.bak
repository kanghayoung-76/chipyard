package chipyard.fpga.fmxcvu19p

import org.chipsalliance.cde.config.{Config}
import rerocc._

import freechips.rocketchip.tile.OpcodeSet   // ← add this import // Custom OpCode

class VelaETHTest extends Config(
  new FPGAGemminiConfig ++                    // FPGA-optimized Gemmini with increased pipeline latency
  new WithNumofMemory ++
  new WithVelaTestHarness ++                  // Use VelaFPGATestHarness (physical pins only, NIC internal)
  new WithFMXCVU19PRJ45Tweaks ++              // Use RJ45 tweaks instead of regular tweaks
  new WithEthernetPins ++                     // HarnessBinder for Ethernet/SGMII pins
  new chipyard.iobinders.WithXilinxEthAdapter ++  // Override WithNICIOPunchthrough - connects IceNIC to XilinxEth SGMII/RJ45
  new freechips.rocketchip.subsystem.WithInclusiveCache(nWays=8, capacityKB=512) ++
  new freechips.rocketchip.subsystem.WithCoherentBusTopology ++
  new freechips.rocketchip.rocket.WithNHugeCores(1) ++                                // single rocket-core
  new chipyard.config.AbstractConfig)

/**
 *  Rocket Core + Gemmini(with Pipeline in PE)
 *  default 2 Mig
**/
class VelaRocketHugeGemmini extends Config(
  new FPGAGemminiConfig ++                    // FPGA-optimized Gemmini with increased pipeline latency
  new WithNumofMemory ++
  new WithVelaTestHarness ++                  // Use VelaFPGATestHarness (physical pins only, NIC internal)
  new WithFMXCVU19PRJ45Tweaks ++              // Use RJ45 tweaks instead of regular tweaks
  new WithEthernetPins ++
  new chipyard.iobinders.WithXilinxEthAdapter ++  // Override WithNICIOPunchthrough - connects IceNIC to XilinxEth SGMII/RJ45
  new freechips.rocketchip.subsystem.WithInclusiveCache(nWays=8, capacityKB=512) ++
  new freechips.rocketchip.subsystem.WithCoherentBusTopology ++
  new freechips.rocketchip.rocket.WithNHugeCores(1) ++                                // single rocket-core
  new chipyard.config.AbstractConfig)

