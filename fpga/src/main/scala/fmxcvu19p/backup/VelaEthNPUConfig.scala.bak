// 8 RocketCore with 8 dedicated Gemminis (each Rocketcore has Single Gemmini)
class VelaRocket8CoreDedicatedGemmini extends Config(
  new chipyard.config.WithMultiRoCC ++                          // per-tile RoCC dispatch
  new WithMultiRoCCFPGAGemmini(0, 1, 2, 3, 4, 5, 6, 7)(         // hart 0-7 each get a Gemmini
    FPGAGemminiConfigs.fpgaConfig) ++
  new WithNumofMemory ++
  new WithVelaTestHarness ++
  new WithFMXCVU19PRJ45Tweaks ++
  new WithEthernetPins ++
  new chipyard.iobinders.WithXilinxEthAdapter ++
  new freechips.rocketchip.subsystem.WithInclusiveCache(nWays=8, capacityKB=512) ++
  new freechips.rocketchip.subsystem.WithCoherentBusTopology ++
  new freechips.rocketchip.rocket.WithNHugeCores(8) ++
  new chipyard.config.AbstractConfig)

/*-------------------------------------------------------------------------------------*/
// 1 RocketCore with 1 dedicated Gemminis (each Rocketcore has Single Gemmini)
class VelaSaturnRocket1CoreDedicatedGemmini extends Config(
  new FPGAGemminiConfig ++                    // FPGA-optimized Gemmini with increased pipeline latency
  new WithNumofMemory ++
  new WithVelaTestHarness ++
  new WithFMXCVU19PRJ45Tweaks ++
  new WithEthernetPins ++
  new chipyard.iobinders.WithXilinxEthAdapter ++
  new velasaturn.rocket.WithRocketVectorUnit(512, 256, velasaturn.common.VectorParams.refParams) ++
  new freechips.rocketchip.subsystem.WithInclusiveCache(nWays=8, capacityKB=512) ++
  new freechips.rocketchip.subsystem.WithCoherentBusTopology ++
  new freechips.rocketchip.rocket.WithNHugeCores(1) ++
  new chipyard.config.AbstractConfig)

